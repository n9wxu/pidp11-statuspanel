[Unit]
Description=PiDP-11 infrastructure status panel
Wants=network-online.target ledmux.service
After=network-online.target ledmux.service

[Service]
ExecStart=/usr/bin/python3 /opt/statuspanel/statuspanel.py -c /opt/statuspanel/config.json
User=@USER@
StateDirectory=statuspanel
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
